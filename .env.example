# Restrict the production file to mode 0600. Never commit .env.
# Runtime paths, Workloader and PCE selection belong in config/local.json and
# pce.yaml. Keep this file limited to settings such as optional SMTP secrets.
SMTP_HOST=smtp.example.internal
SMTP_PORT=25
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=rules-recertify@example.internal
SMTP_TO=operations@example.internal
