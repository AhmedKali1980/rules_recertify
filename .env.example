# Restrict the production file to mode 0600. Never commit .env.
# Runtime paths and the PCE normally come from config/local.json. Uncomment an
# override only when it is intentional; environment values take precedence.
# PCE=pce-prd-l3.wr
# WORKLOADER_DIR=/DATA/WORKLOADER/ver12
# WORKLOADER_CONFIG_FILE=/DATA/WORKLOADER/ver12/pce.yaml
# Reference import wrappers (credentials remain exclusively in CFG/pce.yaml).
# EXECUTABLE=/DATA/WORKLOADER/ver12/workloader
# CFG=/DATA/WORKLOADER/ver12/pce.yaml
# PCE_L1_NAME=pce-l1-profile
# PCE_L3SM_NAME=pce-l3sm-profile
# Alternatively, profile keys can be resolved from these hostnames:
# PCE_L1_FQDN=pce-l1.example.internal
# PCE_L3SM_FQDN=pce-l3sm.example.internal
# For an entirely offline import, point to the documented CSV stub directory:
# PCE_STUB_DIR=/path/to/stubs
# STATE_DB=/DATA/mco/illumio-mco/rules_recertify/var/state/rules_recertify.sqlite
SMTP_HOST=smtp.example.internal
SMTP_PORT=25
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=rules-recertify@example.internal
SMTP_TO=operations@example.internal
